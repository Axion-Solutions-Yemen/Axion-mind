 2003         document.getElementById('syncStatusBadge').textContent = 'Cloud backup verified A� ' + new Date(result.verified_at).toLocaleString();
 2004         invoke('log_frontend_event', { level: 'info', tag: 'SYNC', message: `Cloud backup verified: ${result.counts.files} files; ${result.counts.frameworks} frameworks, ${result.counts.anecdotes} anecdotes, ${result.counts.chats} chats.`, details: null }).catch(() => {});
 2005       }
