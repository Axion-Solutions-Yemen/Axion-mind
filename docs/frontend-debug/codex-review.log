  212     // Render Unified Sidebar: Hierarchy of Agents, each holding its own sessions
  213     function renderUnifiedSidebar() {
  214       const filter = searchPersonasEl.value.toLowerCase().trim();
  215 
  216       personasListEl.innerHTML = '';
  217 
  218       // Define default Hermes agent representing native CLI/Telegram/Mind sessions
  219       const hermesAgent = {
