  250 pub fn retrieve_rag_cards(persona_id: &str, query: &str) -> String {
  251     let app_data = match crate::personas::get_app_data_dir() {
  252         Ok(d) => d,
  253         Err(_) => return String::new(),
  254     };
  255     let data_dir = app_data.join("personas_data").join(persona_id);
  256     if !data_dir.exists() {
  257         return String::new();
  258     }
  259 
  260     let q_lower = query.to_lowercase();
  261     let q_words: Vec<&str> = q_lower.split_whitespace().filter(|w| w.len() > 3).collect();
  262 
  263     let mut matched_frameworks: Vec<String> = Vec::new();
  264     let mut matched_anecdotes: Vec<String> = Vec::new();
  265 
  266     // 1. Scan Frameworks
  267     let fw_dir = data_dir.join("frameworks");
  268     if let Ok(entries) = std::fs::read_dir(fw_dir) {
  269         for entry in entries.flatten() {
  270             let path = entry.path();
  271             if path.extension().and_then(|s| s.to_str()) == Some("json") {
  272                 if let Ok(content) = std::fs::read_to_string(&path) {
  273                     if let Ok(val) = serde_json::from_str::<serde_json::Value>(&content) {
  274                         let title = val.get("title").and_then(|v| v.as_str()).unwrap_or("");
  275                         let rules = val.get("rules").and_then(|v| v.as_array());
  276                         
  277                         // Check match score
  278                         let card_text = format!("{} {}", title, content).to_lowercase();
  279                         let matches = q_words.iter().filter(|&&w| card_text.contains(w)).count();
  280                         if matches > 0 || q_words.is_empty() {
  281                             let mut card_str = format!("### FRAMEWORK: {}\n", title);
  282                             if let Some(r_arr) = rules {
  283                                 for r in r_arr {
  284                                     if let Some(r_str) = r.as_str() {
  285                                         card_str.push_str(&format!("- {}\n", r_str));
  286                                     }
  287                                 }
  288                             }
  289                             matched_frameworks.push(card_str);
  290                         }
  291                     }
  292                 }
  293             }
  294         }
  295     }
  296 
  297     // 2. Scan Deal Anecdotes
  298     let an_dir = data_dir.join("anecdotes");
  299     if let Ok(entries) = std::fs::read_dir(an_dir) {
  300         for entry in entries.flatten() {
  301             let path = entry.path();
  302             if path.extension().and_then(|s| s.to_str()) == Some("json") {
  303                 if let Ok(content) = std::fs::read_to_string(&path) {
  304                     if let Ok(val) = serde_json::from_str::<serde_json::Value>(&content) {
  305                         let industry = val.pointer("/anchor/industry").and_then(|v| v.as_str()).unwrap_or("");
  306                         let outcome = val.pointer("/anchor/outcome").and_then(|v| v.as_str()).unwrap_or("");
  307                         let price = val.get("purchase_price").or_else(|| val.pointer("/anchor/deal_size")).and_then(|v| v.as_str()).unwrap_or("");
  308                         let structure = val.get("structure").and_then(|v| v.as_str()).unwrap_or("");
  309                         let lesson = val.get("key_lesson").and_then(|v| v.as_str()).unwrap_or("");
  310 
  311                         let card_text = format!("{} {} {} {} {}", industry, outcome, price, structure, lesson).to_lowercase();
  312                         let matches = q_words.iter().filter(|&&w| card_text.contains(w)).count();
  313                         if matches > 0 || q_words.is_empty() {
  314                             let card_str = format!(
  315                                 "### CASE STUDY / ANECDOTE: {} ({})\n- Outcome: {}\n- Structure: {}\n- Key Math / Lesson: {}\n",
  316                                 industry, price, outcome, structure, lesson
  317                             );
  318                             matched_anecdotes.push(card_str);
  319                         }
  320                     }
  321                 }
  322             }
  323         }
  324     }
  325 
  326     if matched_frameworks.is_empty() && matched_anecdotes.is_empty() {
  327         crate::logger::log_debug("RAG", &format!("No keyword match in knowledge cards for persona '{}' query.", persona_id));
  328         return String::new();
  329     }
  330 
  331     crate::logger::log_info(
  332         "RAG",
  333         &format!(
  334             "Dual-RAG retrieved {} framework(s) and {} anecdote(s) for persona '{}'",
  335             matched_frameworks.len(),
  336             matched_anecdotes.len(),
  337             persona_id
  338         ),
  339     );
  340 
  341     let mut rag_block = String::from("\n\n[RETRIEVED KNOWLEDGE CARDS FROM PERSONA KNOWLEDGE BANK]:\nUse the exact principles, formulas, and verified deal numbers below whenever applicable:\n\n");
  342     for fw in matched_frameworks.iter().take(3) {
  343         rag_block.push_str(fw);
  344         rag_block.push('\n');
  345     }
  346     for an in matched_anecdotes.iter().take(2) {
  347         rag_block.push_str(an);
  348         rag_block.push('\n');
  349     }
  350     rag_block
  351 }
