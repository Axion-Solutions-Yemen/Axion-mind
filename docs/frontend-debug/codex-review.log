  338           else if (s.source === 'api_server') icon = 'dYO?';
  339           else if (s.source === 'agent') icon = '�s�';
  340 
  341           const timeStr = (s.last_activity_at || s.last_active) ? formatTimestamp(s.last_activity_at || s.last_active) : '';
  342 
  343           item.innerHTML = `
