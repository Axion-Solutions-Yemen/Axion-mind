  440 #[tauri::command]
  441 async fn pick_folder() -> Result<Option<String>, String> {
  442     tokio::task::spawn_blocking(move || {
  443         use std::process::Command;
  444         #[cfg(target_os = "windows")]
  445         use std::os::windows::process::CommandExt;
  446 
  447         let ps_script = r#"
  448             Add-Type -AssemblyName System.Windows.Forms
  449             $f = New-Object System.Windows.Forms.FolderBrowserDialog
  450             $f.Description = "Select Persistent Data / Cloud Storage Folder (e.g. OneDrive, Google Drive, D:\Backups)"
  451             $res = $f.ShowDialog()
  452             if ($res -eq [System.Windows.Forms.DialogResult]::OK) {
  453                 Write-Output $f.SelectedPath
  454             }
  455         "#;
  456 
  457         let mut cmd = Command::new("powershell.exe");
  458         #[cfg(target_os = "windows")]
  459         cmd.creation_flags(0x08000000); // CREATE_NO_WINDOW
  460         cmd.arg("-NoProfile")
  461            .arg("-NonInteractive")
  462            .arg("-Command")
  463            .arg(ps_script);
  464 
  465         let output = cmd.output().map_err(|e| e.to_string())?;
  466         let res = String::from_utf8_lossy(&output.stdout).trim().to_string();
  467         if res.is_empty() {
  468             Ok(None)
  469         } else {
  470             Ok(Some(res))
  471         }
  472     })
  473     .await
  474     .map_err(|e| e.to_string())?
  475 }
