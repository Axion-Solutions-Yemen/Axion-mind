 1993       onBusy: busy => {
 1994         cloudJobBusy = busy;
 1995         for (const el of [btnForceCloudSyncEl, recoveryButtonEl, btnLogoutEl, btnSubmitAuthEl, btnGoogleSignInEl, document.getElementById('autoBackupEnabled')]) if (el) el.disabled = busy;
 1996         cancelBackupEl.style.display = busy ? 'inline-flex' : 'none';
 1997         if (!busy && cloudAutoBackup) renderCloudBackupState(cloudAutoBackup.status());
 1998       },
 1999       confirmRecovery: envelope => confirm(`Recover ${envelope.counts.files} verified files into a NEW folder?\nYour active customer files will not be overwritten. You can select the recovered folder in Settings afterward.`),
 2000       onVerified: result => {
 2001         cloudAutoBackup?.recordVerified(result);
