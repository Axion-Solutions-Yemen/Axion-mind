  756                                     name: id.to_string(),
  757                                     provider: "DeepSeek Web Bridge (Port 8769)".to_string(),
  758                                 });
  759                             }
  760                         }
  761                     }
  762                 }
  763             }
  764         }
  765     }
  766 
  767     // 4. Parse Hermes config.yaml for model_aliases
  768     let config_paths = [
  769         dirs::data_local_dir().map(|d| d.join("hermes").join("config.yaml")),
  770         dirs::home_dir().map(|h| h.join(".hermes").join("config.yaml")),
  771     ];
  772 
  773     for maybe_path in config_paths.into_iter().flatten() {
  774         if maybe_path.exists() {
  775             if let Ok(content) = std::fs::read_to_string(&maybe_path) {
  776                 let mut in_aliases = false;
  777                 for line in content.lines() {
  778                     let trimmed = line.trim();
  779                     if trimmed.starts_with("model_aliases:") {
  780                         in_aliases = true;
  781                         continue;
  782                     }
  783                     if in_aliases && !line.starts_with(' ') && !line.starts_with('\t') && !trimmed.is_empty() {
  784                         in_aliases = false;
  785                     }
  786                     if in_aliases && trimmed.ends_with(':') && !trimmed.contains("provider") && !trimmed.contains("model") {
  787                         let alias = trimmed.trim_end_matches(':');
  788                         if !alias.is_empty() && !alias.contains(' ') {
  789                             if seen_ids.insert(alias.to_string()) {
  790                                 models.push(HermesModelOption {
  791                                     id: alias.to_string(),
  792                                     name: format!("{} (Alias)", alias),
  793                                     provider: "Hermes Config Aliases".to_string(),
  794                                 });
  795                             }
  796                         }
  797                     }
  798                 }
  799             }
  800         }
  801     }
  802 
  803     // Fallback standard options if empty
  804     if models.is_empty() {
  805         models.push(HermesModelOption {
  806             id: "antigravity-gemini-3.8-flash".to_string(),
  807             name: "antigravity-gemini-3.8-flash".to_string(),
  808             provider: "Default Local".to_string(),
