  139       // 3. Check legacy/global window.__TAURI__.invoke
  140       if (window.__TAURI__?.invoke) {
  141         return await window.__TAURI__.invoke(cmd, args);
  142       }
  143       // 4. Polling fallback if still initializing
  144       for (let i = 0; i < 30; i++) {
  145         await new Promise(r => setTimeout(r, 50));
  146         if (window.__TAURI_INTERNALS__?.invoke) {
  147           return await window.__TAURI_INTERNALS__.invoke(cmd, args);
  148         }
  149         if (window.__TAURI__?.core?.invoke) {
  150           return await window.__TAURI__.core.invoke(cmd, args);
  151         }
  152         if (window.__TAURI__?.invoke) {
  153           return await window.__TAURI__.invoke(cmd, args);
  154         }
  155       }
  156       console.error('Tauri IPC invoker not found for command:', cmd);
