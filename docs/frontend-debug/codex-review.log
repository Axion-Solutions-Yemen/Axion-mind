  655 #[tauri::command]
  656 async fn get_user_cloud_session() -> Result<Option<serde_json::Value>, String> {
  657     let _lock = ACCOUNT_SESSION_LOCK.lock().await;
  658     let store = auth::SessionStore::production()?;
  659     // Old plaintext cloud_session.json files are deliberately not trusted or imported.
  660     let saved = match store.read()? { Some(s) => s, None => return Ok(None) };
  661     let verified = auth::AuthApi::production()?.validate_or_refresh(&saved).await?;
  662     if let Some(session) = &verified { store.write(session)?; }
  663     else { store.clear()?; }
  664     Ok(verified)
  665 }
