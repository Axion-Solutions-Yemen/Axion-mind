  692 pub async fn list_connected_hermes_models() -> Vec<HermesModelOption> {
  693     let mut models: Vec<HermesModelOption> = Vec::new();
  694     let mut seen_ids = std::collections::HashSet::new();
  695 
  696     let client = reqwest::Client::builder()
  697         .timeout(Duration::from_millis(1500))
  698         .build()
  699         .unwrap_or_default();
  700 
