  136     tokio::task::spawn_blocking(move || {
  137         use std::process::Command;
  138         #[cfg(target_os = "windows")]
  139         use std::os::windows::process::CommandExt;
  140 
  141         let parts: Vec<&str> = command.split_whitespace().collect();
  142         if parts.is_empty() {
  143             return Err("Empty command".to_string());
  144         }
  145 
  146         let mut cmd = Command::new("hermes");
  147         #[cfg(target_os = "windows")]
  148         cmd.creation_flags(0x08000000); // CREATE_NO_WINDOW
  149 
  150         for arg in &parts {
  151             cmd.arg(arg);
  152         }
  153 
  154         let output = cmd.output().map_err(|e| format!("Failed to execute hermes command: {}", e))?;
  155         let stdout = String::from_utf8_lossy(&output.stdout).to_string();
  156         let stderr = String::from_utf8_lossy(&output.stderr).to_string();
  157 
  158         if !output.status.success() && stdout.trim().is_empty() {
  159             return Err(stderr);
  160         }
  161 
  162         Ok(stdout)
  163     })
  164     .await
  165     .map_err(|e| e.to_string())?
  166 }
