  481 #[tauri::command]
  482 async fn set_cloud_auto_backup_disabled(owner:String,scope:String,disabled:bool) -> Result<(),String> {
  483     // Revocation works offline. Re-enabling requires a fresh verified owner and current storage scope.
  484     if !disabled {
  485         let verified=get_user_cloud_session().await?.ok_or("Sign in before enabling automatic backup.")?;
  486         if verified["id"].as_str()!=Some(owner.as_str()) {return Err("Account changed before enabling automatic backup.".into());}
  487     }
  488     let _lock=ACCOUNT_SESSION_LOCK.lock().await;
  489     if !disabled {
  490         let current=auth::SessionStore::production()?.read()?.ok_or("Account signed out.")?;
  491         if current["id"].as_str()!=Some(owner.as_str())||backup::scope_id(&personas::get_app_data_dir()?)?!=scope {return Err("Account or storage changed before enabling automatic backup.".into());}
  492     }
  493     tokio::task::spawn_blocking(move || backup_policy::set_disabled(&cloud_backup_policy_root()?,&owner,&scope,disabled)).await.map_err(|_|"Automatic-backup policy worker failed.".to_string())?
  494 }
