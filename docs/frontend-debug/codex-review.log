    1 use std::{fs, io::{Read, Write}, path::Path, sync::Mutex};
    2 use serde_json::{Value,json};
    3 static TURN_LOCK:Mutex<()>=Mutex::new(());
    4 fn read_array(path:&Path)->Result<Vec<Value>,String>{
    5     let mut file=match fs::File::open(path){Ok(f)=>f,Err(e) if e.kind()==std::io::ErrorKind::NotFound=>return Ok(Vec::new()),Err(e)=>return Err(e.to_string())};
    6     let mut bytes=Vec::new();file.read_to_end(&mut bytes).map_err(|e|e.to_string())?;
    7     serde_json::from_slice(&bytes).map_err(|_|"Existing chat or index is invalid; refusing to overwrite it.".into())
    8 }
    9 fn atomic_json(path:&Path,values:&[Value])->Result<(),String>{
   10     let parent=path.parent().ok_or("Invalid storage path")?;fs::create_dir_all(parent).map_err(|e|e.to_string())?;
   11     let temp=parent.join(format!(".axion-turn-{}.tmp",rand::random::<u128>()));
   12     let result=(||{let mut f=fs::OpenOptions::new().write(true).create_new(true).open(&temp).map_err(|e|e.to_string())?;
   13         f.write_all(&serde_json::to_vec_pretty(values).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;f.sync_all().map_err(|e|e.to_string())?;drop(f);
   14         fs::rename(&temp,path).map_err(|e|e.to_string())})();
   15     if result.is_err(){let _=fs::remove_file(temp);}result
   16 }
   17 pub fn append_turn(root:&Path,session:&str,request:&str,user:&str,answer:&str,model:Option<&str>)->Result<(),String>{
   18     if session.is_empty()||session.len()>256||session.chars().any(|c|c.is_control()||"/\\:<>\"|?*".contains(c))||session=="."||session==".."||session.ends_with(['.',' '])||request.is_empty()||request.len()>128{return Err("Invalid chat identity".into());}
   19     let _lock=TURN_LOCK.lock().map_err(|_|"Chat storage unavailable")?;
   20     let path=root.join("chats").join(format!("{}.json",session));let mut messages=read_array(&path)?;
   21     let prior:Vec<_>=messages.iter().filter(|m|m["request_id"].as_str()==Some(request)).collect();
   22     if !prior.is_empty() && !(prior.len()==2 && prior[0]["role"]=="user" && prior[0]["content"]==user && prior[1]["role"]=="assistant" && prior[1]["content"]==answer){return Err("Request receipt conflicts with existing messages".into());}
   23     if prior.is_empty(){let time=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|e|e.to_string())?.as_secs_f64();
   24         messages.push(json!({"role":"user","content":user,"timestamp":time,"model":null,"request_id":request}));
   25         messages.push(json!({"role":"assistant","content":answer,"timestamp":time,"model":model,"request_id":request}));
   26         atomic_json(&path,&messages)?;
   27     }
   28     let agent=session.split('_').next().ok_or("Invalid chat identity")?;
   29     let meta_path=root.join("sessions").join(format!("{}.json",agent));let mut sessions=read_array(&meta_path)?;
   30     if let Some(meta)=sessions.iter_mut().find(|s|s["id"].as_str()==Some(session)){
   31         meta["message_count"]=json!(messages.len());meta["last_activity_at"]=json!(chrono::Utc::now().timestamp().to_string());atomic_json(&meta_path,&sessions)?;
   32     }
   33     Ok(())
   34 }

