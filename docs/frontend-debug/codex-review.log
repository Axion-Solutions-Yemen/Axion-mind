  553 #[tauri::command]
  554 async fn export_all_data_json() -> Result<serde_json::Value, String> {
  555     tokio::task::spawn_blocking(move || {
  556         let app_dir = crate::personas::get_app_data_dir()?;
  557         
  558         // 1. Read personas.json
  559         let personas_file = app_dir.join("personas.json");
  560         let personas_val: serde_json::Value = if personas_file.exists() {
  561             let s = std::fs::read_to_string(&personas_file).unwrap_or_else(|_| "[]".to_string());
  562             serde_json::from_str(&s).unwrap_or(serde_json::json!([]))
  563         } else {
  564             serde_json::json!([])
  565         };
  566 
  567         // 2. Read all chats
  568         let chats_dir = app_dir.join("chats");
  569         let mut chats_map = serde_json::Map::new();
  570         if let Ok(entries) = std::fs::read_dir(chats_dir) {
  571             for entry in entries.flatten() {
  572                 let path = entry.path();
  573                 if path.extension().and_then(|s| s.to_str()) == Some("json") {
  574                     if let Some(stem) = path.file_stem().and_then(|s| s.to_str()) {
  575                         if let Ok(s) = std::fs::read_to_string(&path) {
  576                             if let Ok(json_msgs) = serde_json::from_str::<serde_json::Value>(&s) {
  577                                 chats_map.insert(stem.to_string(), json_msgs);
  578                             }
  579                         }
  580                     }
  581                 }
  582             }
  583         }
  584 
  585         // 3. Read Dual-RAG Knowledge Cards
  586         let data_dir = app_dir.join("personas_data");
  587         let mut data_files = serde_json::Map::new();
  588         if data_dir.exists() {
  589             for entry in walkdir::WalkDir::new(&data_dir).into_iter().flatten() {
  590                 if entry.file_type().is_file() {
  591                     let path = entry.path();
  592                     if let Ok(rel) = path.strip_prefix(&data_dir) {
  593                         let rel_str = rel.to_string_lossy().replace('\\', "/");
  594                         if let Ok(content) = std::fs::read_to_string(path) {
  595                             data_files.insert(rel_str, serde_json::Value::String(content));
  596                         }
  597                     }
  598                 }
  599             }
  600         }
  601 
  602         Ok(serde_json::json!({
  603             "personas": personas_val,
  604             "chats": chats_map,
  605             "personas_data": data_files
  606         }))
  607     })
  608     .await
  609     .map_err(|e| e.to_string())?
  610 }
