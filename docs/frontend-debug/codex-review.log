  693     match result {
  694         Ok(session) => {
  695             let _lock = ACCOUNT_SESSION_LOCK.lock().await;
  696             auth::SessionStore::production()?.write(&session)?;
  697             logger::log_info("AUTH", "Google account verified; encrypted session saved. Data sync is separate.");
  698             Ok(session)
  699         },
  700         Err(e) => {
  701             logger::log_warn("AUTH", &e, None);
  702             Err(e)
  703         }
  704     }
  705 }
