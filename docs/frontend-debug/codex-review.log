  109     pub fn log(&self, level: LogLevel, tag: &str, message: &str, details: Option<&str>, file_line: Option<&str>) {
  110         let now: DateTime<Local> = Local::now();
  111         let timestamp = now.format("%Y-%m-%d %H:%M:%S%.3f").to_string();
  112 
  113         let entry = LogEntry {
  114             timestamp: timestamp.clone(),
  115             level: level.clone(),
  116             tag: tag.to_uppercase(),
  117             message: message.to_string(),
  118             details: details.map(|s| s.to_string()),
  119             file_line: file_line.map(|s| s.to_string()),
  120         };
  121 
  122         // 1. In-memory ring buffer for fast UI diagnosis
  123         if let Ok(mut logs) = self.recent_logs.lock() {
  124             if logs.len() >= self.max_memory_logs {
  125                 logs.remove(0);
  126             }
  127             logs.push(entry.clone());
  128         }
  129 
  130         // 2. Write to persistent daily disk log
  131         let date_str = now.format("%Y-%m-%d").to_string();
  132         let log_file_name = format!("axion_mind_{}.log", date_str);
  133         let log_file_path = self.log_dir.join(log_file_name);
  134 
