  795     // --- Desktop & Toast Notification Trigger ---
  796     async function triggerResponseNotification(agentName, textContent) {
  797       const cleanSnippet = (textContent || '')
  798         .replace(/[*#_`>]/g, '')
  799         .replace(/\n+/g, ' ')
  800         .trim()
  801         .slice(0, 140);
  802 
  803       // Suppress notifications and chime on empty responses or error states
  804       if (!cleanSnippet || cleanSnippet.startsWith('[Empty response') || cleanSnippet.startsWith('[Error')) {
  805         return;
  806       }
  807 
  808       playNotificationChime();
  809 
  810       const title = `�s� ${agentName || 'Axion Mind'} finished`;
  811       const body = cleanSnippet;
  812 
  813       // Prioritize native Windows WinRT toast via Rust IPC; avoid duplicate web notifications
  814       let nativeDelivered = false;
  815       try {
  816         await invoke('show_desktop_notification', { title, body });
  817         nativeDelivered = true;
  818       } catch (_) {}
  819 
  820       // Fallback: Web Notification API (only if native toast did not succeed)
  821       if (!nativeDelivered && window.Notification) {
  822         if (Notification.permission === 'granted') {
  823           try {
  824             const n = new Notification(title, {
  825               body: body,
  826               icon: 'assets/app_logo.png'
  827             });
  828             n.onclick = () => { window.focus(); n.close(); };
  829           } catch (_) {}
  830         } else if (Notification.permission === 'default') {
  831           Notification.requestPermission();
  832         }
  833       }
  834     }
