   46 pub async fn stream_hermes_chat(
   47     session_id: &str,
   48     message: &str,
   49     channel: Channel<ChatStreamEvent>,
   50     request_id: Option<String>,
   51 ) -> Result<(), String> {
   52     let mut cancellation = crate::chat_cancel::register(request_id)?;
   53     let config = load_config();
   54     let client = reqwest::Client::builder()
   55         .timeout(Duration::from_secs(180))
   56         .build()
   57         .map_err(|e| e.to_string())?;
   58 
   59     let base_url = config.hermes_gateway_url.trim_end_matches('/');
   60     let url = format!("{}/api/sessions/{}/chat", base_url, session_id);
   61     let mut headers = HeaderMap::new();
   62     headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
   63     if !config.hermes_auth_token.trim().is_empty() {
   64         if let Ok(val) = HeaderValue::from_str(&format!("Bearer {}", config.hermes_auth_token.trim())) {
   65             headers.insert(AUTHORIZATION, val);
   66         }
   67     }
   68 
   69     let start_time = std::time::Instant::now();
   70     let body = serde_json::json!({ "message": message });
   71 
   72     let response = cancellation.run(async { client
   73         .post(&url)
   74         .headers(headers)
   75         .json(&body)
   76         .send()
   77         .await
   78         .map_err(|e| format!("Failed to connect to Hermes Gateway ({}): {}", url, e)) }).await?;
   79 
   80     if !response.status().is_success() {
   81         let err_text = cancellation.run(async { Ok(response.text().await.unwrap_or_default()) }).await?;
   82         channel
   83             .send(ChatStreamEvent::Error {
   84                 message: format!("Gateway error: {}", err_text),
   85             })
   86             .ok();
   87         return Ok(());
   88     }
   89 
   90     let is_event_stream = response
   91         .headers()
   92         .get(CONTENT_TYPE)
   93         .and_then(|v| v.to_str().ok())
   94         .map(|ct| ct.contains("text/event-stream"))
   95         .unwrap_or(false);
   96 
   97     if !is_event_stream {
   98         let full_body = cancellation.run(async { response.bytes().await.map_err(|e| e.to_string()) }).await?;
   99         if let Ok(json_val) = serde_json::from_slice::<serde_json::Value>(&full_body) {
  100             if let Some(err_val) = json_val.get("error") {
  101                 let err_msg = if let Some(s) = err_val.as_str() {
  102                     s.to_string()
  103                 } else if let Some(m) = err_val.get("message").and_then(|m| m.as_str()) {
  104                     m.to_string()
  105                 } else {
  106                     err_val.to_string()
  107                 };
  108                 channel.send(ChatStreamEvent::Error { message: err_msg }).ok();
  109                 return Ok(());
  110             }
  111 
  112             if let Some(choices) = json_val.get("choices").and_then(|c| c.as_array()) {
  113                 if let Some(first) = choices.get(0) {
  114                     if let Some(content) = first.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  115                         channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  116                     } else if let Some(delta) = first.get("delta").and_then(|d| d.get("content")).and_then(|c| c.as_str()) {
  117                         channel.send(ChatStreamEvent::Token { delta: delta.to_string() }).ok();
  118                     }
  119                 }
  120             } else if let Some(content) = json_val.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  121                 channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  122             } else if let Some(delta) = json_val.get("delta").and_then(|d| d.as_str()) {
  123                 channel.send(ChatStreamEvent::Token { delta: delta.to_string() }).ok();
  124             }
  125         }
  126         let elapsed = start_time.elapsed().as_secs_f64();
  127         channel.send(ChatStreamEvent::Done { elapsed_sec: elapsed }).ok();
  128         return Ok(());
  129     }
  130 
  131     let mut stream = response.bytes_stream();
  132     let mut byte_buffer = Vec::new();
  133     let mut has_terminal_error = false;
  134     let mut token_count = 0;
  135 
  136     while let Some(chunk_res) = cancellation.run(async { Ok(stream.next().await) }).await? {
  137         let chunk = match chunk_res {
  138             Ok(c) => c,
  139             Err(e) => {
  140                 has_terminal_error = true;
  141                 channel
  142                     .send(ChatStreamEvent::Error {
  143                         message: format!("Stream read error: {}", e),
  144                     })
  145                     .ok();
  146                 break;
  147             }
  148         };
  149 
  150         byte_buffer.extend_from_slice(&chunk);
  151 
  152         while let Some(pos) = byte_buffer.iter().position(|&b| b == b'\n') {
  153             let line_bytes = &byte_buffer[..pos];
  154             let line = String::from_utf8_lossy(line_bytes).trim().to_string();
  155             byte_buffer.drain(..pos + 1);
  156 
  157             if line.is_empty() || line.starts_with(':') {
  158                 continue;
  159             }
  160 
  161             let data_str = if line.starts_with("data: ") {
  162                 line[6..].trim()
  163             } else if line.starts_with("data:") {
  164                 line[5..].trim()
  165             } else {
  166                 line.as_str()
  167             };
  168 
  169             if data_str == "[DONE]" {
  170                 let elapsed = start_time.elapsed().as_secs_f64();
  171                 if token_count == 0 {
  172                     channel.send(ChatStreamEvent::Error {
  173                         message: "No response text generated by model (reasoning only or empty stream)".to_string(),
  174                     }).ok();
  175                 } else {
  176                     channel.send(ChatStreamEvent::Done { elapsed_sec: elapsed }).ok();
  177                 }
  178                 return Ok(());
  179             }
  180 
  181             if let Ok(json_val) = serde_json::from_str::<serde_json::Value>(data_str) {
  182                 if let Some(delta) = provider_reasoning(&json_val) {
  183                     channel.send(ChatStreamEvent::Thinking { delta: delta.to_string() }).ok();
  184                 }
  185                 if let Some(err_val) = json_val.get("error") {
  186                     let err_msg = if let Some(s) = err_val.as_str() {
  187                         s.to_string()
  188                     } else if let Some(m) = err_val.get("message").and_then(|m| m.as_str()) {
  189                         m.to_string()
  190                     } else {
  191                         err_val.to_string()
  192                     };
  193                     has_terminal_error = true;
  194                     channel.send(ChatStreamEvent::Error { message: err_msg }).ok();
  195                     return Ok(());
  196                 } else if let Some(content) = json_val.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  197                     token_count += 1;
  198                     channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  199                 } else if let Some(delta) = json_val.get("delta").and_then(|d| d.as_str()) {
  200                     token_count += 1;
  201                     channel.send(ChatStreamEvent::Token { delta: delta.to_string() }).ok();
  202                 } else if let Some(choices) = json_val.get("choices").and_then(|c| c.as_array()) {
  203                     if let Some(first) = choices.get(0) {
  204                         if let Some(content) = first.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  205                             token_count += 1;
  206                             channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  207                         } else if let Some(delta) = first.get("delta").and_then(|d| d.get("content")).and_then(|c| c.as_str()) {
  208                             token_count += 1;
  209                             channel.send(ChatStreamEvent::Token { delta: delta.to_string() }).ok();
  210                         }
  211                     }
  212                 }
  213             }
  214         }
  215     }
  216 
  217     // Process any remaining non-delimited JSON in buffer
  218     let remaining = String::from_utf8_lossy(&byte_buffer).trim().to_string();
  219     if !remaining.is_empty() {
  220         let clean_json = if remaining.starts_with("data: ") {
  221             &remaining[6..]
  222         } else if remaining.starts_with("data:") {
  223             &remaining[5..]
  224         } else {
  225             &remaining
  226         };
  227         if let Ok(json_val) = serde_json::from_str::<serde_json::Value>(clean_json) {
  228                 if let Some(delta) = provider_reasoning(&json_val) {
  229                     channel.send(ChatStreamEvent::Thinking { delta: delta.to_string() }).ok();
  230                 }
  231             if let Some(content) = json_val.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  232                 channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  233             } else if let Some(choices) = json_val.get("choices").and_then(|c| c.as_array()) {
  234                 if let Some(first) = choices.get(0) {
  235                     if let Some(content) = first.get("message").and_then(|m| m.get("content")).and_then(|c| c.as_str()) {
  236                         channel.send(ChatStreamEvent::Token { delta: content.to_string() }).ok();
  237                     }
  238                 }
  239             }
  240         }
  241     }
  242 
  243     if !has_terminal_error {
  244         let elapsed = start_time.elapsed().as_secs_f64();
  245         channel.send(ChatStreamEvent::Done { elapsed_sec: elapsed }).ok();
  246     }
  247     Ok(())
  248 }
