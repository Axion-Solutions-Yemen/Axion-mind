    3 #[derive(Default)]
    4 struct Registry { active: HashMap<String, watch::Sender<bool>>, latest: Option<String>, early: VecDeque<String> }
    5 static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
    6 fn registry() -> &'static Mutex<Registry> { REGISTRY.get_or_init(|| Mutex::new(Registry::default())) }
    7 pub struct RequestGuard { id: String, receiver: watch::Receiver<bool> }
    8 pub fn register(id: Option<String>) -> Result<RequestGuard, String> {
    9     let id = id.unwrap_or_else(|| format!("native-{}",rand::random::<u128>()));
   10     let mut registry=registry().lock().map_err(|_|"Cancellation registry unavailable")?;
   11     if registry.active.contains_key(&id) { return Err("Request already active".into()); }
   12     let early = registry.early.iter().position(|key| key == &id).and_then(|position| registry.early.remove(position)).is_some();
   13     let (sender, receiver)=watch::channel(early);
   14     registry.active.insert(id.clone(),sender); registry.latest=Some(id.clone());
   15     Ok(RequestGuard{id,receiver})
   16 }
   17 pub fn cancel(id: Option<&str>) {
   18     if let Ok(mut registry)=registry().lock() {
   19         if let Some(key)=id.or(registry.latest.as_deref()) {
   20             if let Some(sender)=registry.active.get(key) { sender.send_replace(true); }
   21             else if let Some(id)=id { if id.len()<=128 && !registry.early.iter().any(|key| key==id) {
   22                 registry.early.push_back(id.to_owned()); if registry.early.len()>128 {registry.early.pop_front();}
   23             } }
   24         }
   25     }
   26 }
   27 impl RequestGuard {
   28     pub async fn run<T, F: Future<Output=Result<T,String>>>(&mut self, future:F) -> Result<T,String> {
   29         let receiver=&mut self.receiver;
   30         tokio::select! { biased;
   31             _ = async { while !*receiver.borrow_and_update() { if receiver.changed().await.is_err() {break;} } } => Err("Generation cancelled".into()),
   32             result = future => result
   33         }
   34     }
   35 }
   36 impl Drop for RequestGuard {
   37     fn drop(&mut self) { if let Ok(mut r)=registry().lock() {r.active.remove(&self.id);if r.latest.as_deref()==Some(&self.id){r.latest=None;}} }
   38 }

