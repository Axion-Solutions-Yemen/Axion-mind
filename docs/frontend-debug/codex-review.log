  356     function formatTimestamp(ts) {
  357       if (!ts) return '';
  358       const d = new Date(ts > 10000000000 ? ts : ts * 1000);
  359       const now = new Date();
  360       const diffSec = Math.floor((now - d) / 1000);
  361       if (diffSec < 60) return 'just now';
  362       if (diffSec < 3600) return `${Math.floor(diffSec / 60)}m ago`;
  363       if (diffSec < 86400) return `${Math.floor(diffSec / 3600)}h ago`;
  364       return `${d.getMonth() + 1}/${d.getDate()}`;
  365     }
