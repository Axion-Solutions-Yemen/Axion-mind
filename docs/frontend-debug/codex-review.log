  138         }
  139         formatted_line.push('\n');
  140         if let Some(det) = details {
  141             formatted_line.push_str(&format!("    DETAILS: {}\n", det));
  142         }
  143 
  144         if let Ok(mut file) = OpenOptions::new().create(true).append(true).open(&log_file_path) {
