  546         let destination=parent.join(format!("recovered-{:032x}",rand::random::<u128>()));
  547         backup::restore_new(&snapshot,&destination)?;
  548         logger::log_info("SYNC","Cloud recovery written and verified in a NEW folder. Active customer files were not replaced.");
  549         Ok(serde_json::json!({"path":destination.to_string_lossy(),"files":snapshot["files"].as_object().map_or(0,|f|f.len()),"verified":true}))
  550     }).await.map_err(|_|"Cloud recovery worker failed.".to_string())?
