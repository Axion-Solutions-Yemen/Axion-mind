  653 static ACCOUNT_SESSION_LOCK: tokio::sync::Mutex<()> = tokio::sync::Mutex::const_new(());
  654 
  655 #[tauri::command]
  656 async fn get_user_cloud_session() -> Result<Option<serde_json::Value>, String> {
  657     let _lock = ACCOUNT_SESSION_LOCK.lock().await;
  658     let store = auth::SessionStore::production()?;
  659     // Old plaintext cloud_session.json files are deliberately not trusted or imported.
  660     let saved = match store.read()? { Some(s) => s, None => return Ok(None) };
  661     let verified = auth::AuthApi::production()?.validate_or_refresh(&saved).await?;
  662     if let Some(session) = &verified { store.write(session)?; }
  663     else { store.clear()?; }
  664     Ok(verified)
  665 }
  666 
  667 #[tauri::command]
  668 async fn save_user_cloud_session(session: serde_json::Value) -> Result<(), String> {
  669     let _lock = ACCOUNT_SESSION_LOCK.lock().await;
  670     let verified = auth::AuthApi::production()?.validate_session(&session).await?
  671         .ok_or("The account session could not be verified. Please sign in again.")?;
  672     auth::SessionStore::production()?.write(&verified)?;
  673     logger::log_info("AUTH", "Verified account session saved with Windows DPAPI encryption.");
  674     Ok(())
  675 }
  676 
  677 #[tauri::command]
  678 async fn clear_user_cloud_session() -> Result<(), String> {
  679     auth::AUTH_FLOWS.cancel()?;
  680     let _lock = ACCOUNT_SESSION_LOCK.lock().await;
  681     auth::SessionStore::production()?.clear()?;
  682     logger::log_info("AUTH", "Local account session cleared. Cloud data was not deleted.");
  683     Ok(())
  684 }
