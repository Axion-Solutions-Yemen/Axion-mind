  624 pub async fn test_ai_connection(config: AppConfig) -> Result<String, String> {
  625     let client = reqwest::Client::builder()
  626         .timeout(Duration::from_secs(12))
  627         .build()
  628         .map_err(|e| e.to_string())?;
  629 
  630     let (url, auth_token, active_model) = match config.mode.as_str() {
  631         "direct_cloud" => {
  632             let ep = match config.cloud_provider.as_str() {
  633                 "openai" => "https://api.openai.com/v1/chat/completions",
  634                 "openrouter" => "https://openrouter.ai/api/v1/chat/completions",
  635                 "groq" => "https://api.groq.com/openai/v1/chat/completions",
  636                 "gemini" => "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
  637                 _ => "https://api.openai.com/v1/chat/completions"
  638             };
  639             (ep.to_string(), config.cloud_api_key.trim().to_string(), config.cloud_model.trim().to_string())
  640         },
  641         "custom_gateway" => {
  642             (config.custom_url.trim().to_string(), config.custom_auth_token.trim().to_string(), config.custom_model.trim().to_string())
  643         },
  644         _ => { // "hermes_local"
  645             let ep = format!("{}/v1/chat/completions", config.hermes_gateway_url.trim_end_matches('/'));
  646             (ep, config.hermes_auth_token.trim().to_string(), "antigravity-gemini-3.8-flash".to_string())
  647         }
  648     };
  649 
  650     let mut headers = HeaderMap::new();
  651     headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
  652     if !auth_token.is_empty() {
  653         if let Ok(val) = HeaderValue::from_str(&format!("Bearer {}", auth_token)) {
  654             headers.insert(AUTHORIZATION, val);
  655         }
  656     }
  657 
  658     let start_time = std::time::Instant::now();
  659     let body = serde_json::json!({
  660         "model": active_model,
  661         "stream": false,
  662         "max_tokens": 5,
  663         "messages": [
  664             { "role": "user", "content": "ping" }
  665         ]
  666     });
  667 
  668     let resp = client
  669         .post(&url)
  670         .headers(headers)
  671         .json(&body)
  672         .send()
  673         .await
  674         .map_err(|e| format!("Failed to reach {}: {}", url, e))?;
  675 
  676     let elapsed = start_time.elapsed().as_millis();
  677     if resp.status().is_success() {
  678         Ok(format!("Connected! Model: {} (Latency: {}ms)", active_model, elapsed))
  679     } else {
  680         let err_body = resp.text().await.unwrap_or_default();
  681         Err(format!("Server returned error: {}", err_body))
  682     }
  683 }
