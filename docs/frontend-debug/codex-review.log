  243         if (isHermes) {
  244           agentSessions = hermesSessions;
  245         } else {
  246           agentSessions = agentSessionsMap[agent.id] || [];
  247         }
  248 
  249         // Apply filter
  250         const matchesAgent = agent.name.toLowerCase().includes(filter) || (agent.title && agent.title.toLowerCase().includes(filter));
  251         const filteredSessions = matchesAgent 
  252           ? agentSessions 
  253           : agentSessions.filter(s => (s.title && s.title.toLowerCase().includes(filter)) || (s.id && s.id.toLowerCase().includes(filter)));
  254 
  255         if (!matchesAgent && filteredSessions.length === 0) {
  256           return;
  257         }
  258 
  259         // Agent Card Accordion
  260         const card = document.createElement('div');
  261         const isExpanded = expandedAgents.has(agent.id) || filter.length > 0;
  262         const isCurrentAgent = activeAgentId === agent.id;
  263         card.className = `agent-card ${isExpanded ? 'expanded' : ''} ${isCurrentAgent ? 'active-agent' : ''}`;
  264 
  265         // Header
  266         const cardHeader = document.createElement('div');
  267         cardHeader.className = 'agent-card-header';
  268         cardHeader.onclick = (e) => {
  269           if (e.target.closest('.agent-toggle') || e.target.closest('.agent-card-header')) {
  270             if (expandedAgents.has(agent.id)) {
  271               expandedAgents.delete(agent.id);
  272             } else {
  273               expandedAgents.add(agent.id);
  274             }
  275             card.classList.toggle('expanded', expandedAgents.has(agent.id));
  276           }
  277         };
  278 
  279         const avatarEmoji = agent.avatar || agent.emoji || 'dY-';
  280         cardHeader.innerHTML = `
  281           <div class="agent-avatar">${escapeHtml(avatarEmoji)}</div>
  282           <div class="agent-info">
  283             <div class="agent-name-row">
  284               <span class="agent-name">${escapeHtml(agent.name)}</span>
  285               <span class="agent-sessions-count">${filteredSessions.length} sess</span>
  286             </div>
  287             <div class="agent-title">${escapeHtml(agent.title || agent.description || '')}</div>
  288           </div>
  289           <span class="agent-toggle">�-�</span>
  290         `;
  291         card.appendChild(cardHeader);
  292 
  293         // Sessions Container
  294         const sessContainer = document.createElement('div');
  295         sessContainer.className = 'agent-sessions-container';
  296 
  297         // "New Session" button for each agent
  298         const newChatBtn = document.createElement('div');
