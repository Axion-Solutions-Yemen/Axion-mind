 1948     function cloudBackupStatus(message, kind = 'info') {
 1949       authFeedbackEl.style.display = 'block';
 1950       authFeedbackEl.style.whiteSpace = 'pre-wrap';
 1951       authFeedbackEl.style.overflowWrap = 'anywhere';
 1952       authFeedbackEl.style.background = kind === 'error' ? 'rgba(239,68,68,.15)' : kind === 'success' ? 'rgba(16,185,129,.15)' : 'rgba(59,130,246,.15)';
 1953       authFeedbackEl.style.color = kind === 'error' ? '#fca5a5' : kind === 'success' ? '#a7f3d0' : '#93c5fd';
 1954       authFeedbackEl.textContent = message;
 1955     }
 1956     function renderCloudBackupState(state) {
 1957       const own = !state.owner || state.owner === cloudAccountSession?.id;
 1958       const toggle = document.getElementById('autoBackupEnabled');
 1959       toggle.checked = own && state.enabled;
 1960       toggle.disabled = cloudJobBusy || !cloudAccountSession || !own || (!state.enabled && ['checking', 'signed-out', 'unavailable'].includes(state.state));
 1961       let detail = 'Checking the current account and local files...', short = 'Checking backup';
 1962       if (!own) { detail = 'Account changed. Backup status is being rechecked.'; }
 1963       else if (state.state === 'signed-out') { detail = 'Local-only mode. Sign in to back up or recover data.'; short = 'Local only'; }
 1964       else if (state.state === 'verified') { detail = 'Local files match the last verified cloud backup.'; short = 'Backup matches local'; }
 1965       else if (state.state === 'backing-up') { detail = 'Backing up and reading back cloud contents. Verification is not complete yet.'; short = 'Backing up...'; }
 1966       else if (state.state === 'retrying') { detail = 'Backup incomplete. Local changes remain unverified. Next automatic retry: ' + new Date(state.nextAttemptAt).toLocaleTimeString(); short = 'Backup retry pending'; }
 1967       else if (state.persistenceError) { detail = 'Automatic backups are OFF for this run only. The off setting could not be saved; it may not survive a restart.'; short = 'Off setting not saved'; }
 1968       else if (state.state === 'paused') { detail = 'Automatic backup paused after an authentication, permission or validation failure. Fix the issue, then turn the option off/on to retry.'; short = 'Backup paused'; }
 1969       else if (state.state === 'unavailable') { detail = 'Cannot currently verify the account or local files. No up-to-date cloud claim is made; your local data is retained.'; short = 'Backup status unknown'; }
 1970       else if (state.dirty) { detail = state.enabled ? 'Local changes are pending backup. The app will retry when the schedule allows.' : 'Local changes are not backed up. Use Back Up & Verify Now or enable automatic backups.'; short = 'Changes not backed up'; }
 1971       const at = own && state.lastVerifiedAt ? new Date(state.lastVerifiedAt).toLocaleString() : 'No verified backup recorded on this device for this account/folder';
 1972       document.getElementById('cloudBackupSummary').textContent = detail + '\nLast verified: ' + at + '\nAutomatic backups: ' + (own && state.enabled ? 'ON while this app is open' : 'OFF');
 1973       document.getElementById('sidebarBackupStatus').textContent = short;
 1974       document.getElementById('sidebarBackupStatus').style.color = own && state.state === 'verified' ? 'var(--ax-success)' : state.dirty ? 'var(--ax-warning)' : 'var(--ax-text-muted)';
 1975       document.getElementById('syncStatusBadge').textContent = own && state.lastVerifiedAt ? 'Last verified: ' + at + (state.dirty ? ' A� local changes pending' : '') : 'Signed in A� Backup status is separate';
 1976     }
 1977     const cloudBackupEngine = window.AxionCloudSync.createEngine({
 1978       key: 'sb_publishable_m6nFD1nyCmeP5xMz0K_5Hw_HqIHOr2N',
 1979       getSession: () => invoke('get_user_cloud_session'),
 1980       ownerNow: () => cloudAccountSession?.id,
 1981       snapshotNow: () => invoke('export_cloud_snapshot'),
 1982       confirmPlan: (plan, user, settings) => settings.automatic
 1983         ? settings.autoOwner === user.id && cloudAutoBackup.authorized(user.id, settings.autoScope, plan.digest)
 1984         : confirm(`Back up all LOCAL customer data to ${user.email}?\n\n${plan.counts.personas} personas, ${plan.counts.frameworks} frameworks, ${plan.counts.anecdotes} anecdotes, ${plan.counts.chats} chats; ${plan.counts.files} files.\n\nLocal files may include work from another signed-in account. Continue only if this account should receive that data. No cloud records will be deleted.`),
 1985       onState: state => {
 1986         const labels = { authenticating: 'Verifying cloud account...', exporting: 'Preparing the complete backup manifest...', uploading: 'Uploading personas, knowledge cards, and chats...', downloading: 'Downloading the latest complete cloud backup...', verifying: 'Reading back and verifying cloud contents...' };
 1987         if (labels[state.state]) cloudBackupStatus(labels[state.state]);
