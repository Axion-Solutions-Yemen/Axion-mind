  686 #[tauri::command]
  687 async fn sign_in_with_google(app: tauri::AppHandle) -> Result<serde_json::Value, String> {
  688     use tauri_plugin_opener::OpenerExt;
  689     logger::log_info("AUTH", "Google sign-in requested (system browser / PKCE).");
  690     let result = auth::run_google_session(&auth::AuthApi::production()?, |url| {
  691         app.opener().open_url(url, None::<&str>).map_err(|_| "Browser launch failed.".to_string())
