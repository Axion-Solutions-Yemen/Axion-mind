  364 #[tauri::command]
  365 async fn restore_customer_backup(zip_path: String) -> Result<usize, String> {
  366     tokio::task::spawn_blocking(move || {
  367         use std::fs::{self, File};
  368         use std::io::copy;
  369 
  370         let hub_dir = personas::get_app_data_dir()?;
  371         let zpath = std::path::Path::new(&zip_path);
  372         if !zpath.exists() {
  373             return Err("Selected backup file does not exist.".to_string());
  374         }
  375 
  376         let file = File::open(zpath).map_err(|e| format!("Cannot open zip file: {}", e))?;
  377         let mut archive = zip::ZipArchive::new(file).map_err(|e| format!("Invalid zip archive: {}", e))?;
  378 
  379         let mut restored_count = 0;
  380         for i in 0..archive.len() {
  381             let mut file = archive.by_index(i).map_err(|e| e.to_string())?;
  382             let raw_path = file.mangled_name();
  383             let outpath = hub_dir.join(&raw_path);
  384 
  385             if file.name().ends_with('/') {
  386                 let _ = fs::create_dir_all(&outpath);
  387             } else {
  388                 if let Some(p) = outpath.parent() {
  389                     let _ = fs::create_dir_all(p);
  390                 }
  391                 let mut outfile = File::create(&outpath).map_err(|e| e.to_string())?;
  392                 copy(&mut file, &mut outfile).map_err(|e| e.to_string())?;
  393                 restored_count += 1;
  394             }
  395         }
  396         Ok(restored_count)
  397     })
  398     .await
  399     .map_err(|e| e.to_string())?
  400 }
