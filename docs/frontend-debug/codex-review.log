  702     if let Ok(resp) = client.get("http://127.0.0.1:8766/v1/models").send().await {
  703         if resp.status().is_success() {
  704             if let Ok(json) = resp.json::<serde_json::Value>().await {
  705                 if let Some(list) = json.get("data").and_then(|d| d.as_array()) {
  706                     for item in list {
  707                         if let Some(id) = item.get("id").and_then(|s| s.as_str()) {
  708                             if seen_ids.insert(id.to_string()) {
  709                                 models.push(HermesModelOption {
  710                                     id: id.to_string(),
  711                                     name: id.to_string(),
  712                                     provider: "Antigravity Bridge (Port 8766)".to_string(),
  713                                 });
  714                             }
  715                         }
  716                     }
  717                 }
  718             }
  719         }
  720     }
  721 
  722     // 2. Probe Gemini Web Bridge (Port 8768)
  723     if let Ok(resp) = client.get("http://127.0.0.1:8768/v1/models").send().await {
  724         if resp.status().is_success() {
  725             if let Ok(json) = resp.json::<serde_json::Value>().await {
  726                 if let Some(list) = json.get("data").and_then(|d| d.as_array()) {
  727                     for item in list {
  728                         if let Some(id) = item.get("id").and_then(|s| s.as_str()) {
  729                             // Filter internal hashes
  730                             if !id.chars().all(|c| c.is_ascii_hexdigit() && id.len() > 10) {
  731                                 if seen_ids.insert(id.to_string()) {
  732                                     models.push(HermesModelOption {
  733                                         id: id.to_string(),
  734                                         name: id.to_string(),
  735                                         provider: "Gemini Web Bridge (Port 8768)".to_string(),
  736                                     });
  737                                 }
  738                             }
  739                         }
  740                     }
  741                 }
  742             }
  743         }
  744     }
  745 
  746     // 3. Probe DeepSeek Web Bridge (Port 8769)
  747     if let Ok(resp) = client.get("http://127.0.0.1:8769/v1/models").send().await {
  748         if resp.status().is_success() {
  749             if let Ok(json) = resp.json::<serde_json::Value>().await {
  750                 if let Some(list) = json.get("data").and_then(|d| d.as_array()) {
  751                     for item in list {
  752                         if let Some(id) = item.get("id").and_then(|s| s.as_str()) {
  753                             if seen_ids.insert(id.to_string()) {
  754                                 models.push(HermesModelOption {
