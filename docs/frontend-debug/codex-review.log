  222         title: 'Autonomous System Agent & CLI/Telegram Engine',
  223         avatar: '�s�',
  224         emoji: '�s�',
  225         description: 'Native Hermes mind executing system commands, terminal, and live sessions.',
  226         model: 'antigravity-gemini-3.8-flash',
  227         isDefaultHermes: true,
