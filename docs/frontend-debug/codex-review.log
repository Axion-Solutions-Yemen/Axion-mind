   29 fn provider_reasoning(packet: &serde_json::Value) -> Option<&str> {
   30     let first = packet.get("choices")?.get(0)?;
   31     let delta = first.get("delta").or_else(|| first.get("message"))?;
   32     delta.get("reasoning_content").or_else(|| delta.get("reasoning"))?.as_str().filter(|s| !s.is_empty())
   33 }
