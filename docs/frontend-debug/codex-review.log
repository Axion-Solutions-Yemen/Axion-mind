  353 pub async fn stream_persona_chat(
  354     persona_id: &str,
  355     message: &str,
  356     system_prompt: &str,
  357     persona_model: Option<&str>,
  358     channel: Channel<ChatStreamEvent>,
  359     request_id: Option<String>,
  360 ) -> Result<(), String> {
  361     let mut cancellation = crate::chat_cancel::register(request_id)?;
  362     let start_instant = std::time::Instant::now();
  363     let config = load_config();
  364     let client = reqwest::Client::builder()
  365         .timeout(Duration::from_secs(180))
  366         .build()
  367         .map_err(|e| e.to_string())?;
  368 
  369     // Dynamically retrieve high-signal cards from AppData Knowledge Bank
  370     let rag_context = retrieve_rag_cards(persona_id, message);
  371     let augmented_system_prompt = if !rag_context.is_empty() {
  372         format!("{}{}", system_prompt, rag_context)
  373     } else {
  374         system_prompt.to_string()
  375     };
  376 
  377     let (url, auth_token, active_model) = match config.mode.as_str() {
  378         "direct_cloud" => {
  379             let ep = match config.cloud_provider.as_str() {
  380                 "openai" => "https://api.openai.com/v1/chat/completions",
  381                 "openrouter" => "https://openrouter.ai/api/v1/chat/completions",
  382                 "groq" => "https://api.groq.com/openai/v1/chat/completions",
  383                 "gemini" => "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
  384                 _ => "https://api.openai.com/v1/chat/completions"
  385             };
  386             (ep.to_string(), config.cloud_api_key.trim().to_string(), config.cloud_model.trim().to_string())
  387         },
  388         "custom_gateway" => {
  389             let target_model = if !config.custom_model.trim().is_empty() {
  390                 config.custom_model.trim().to_string()
  391             } else {
  392                 persona_model.unwrap_or("antigravity-gemini-3.8-flash").to_string()
  393             };
  394             (config.custom_url.trim().to_string(), config.custom_auth_token.trim().to_string(), target_model)
  395         },
  396         _ => { // "hermes_local"
  397             let target_model = if let Some(m) = persona_model {
  398                 m.to_string()
  399             } else {
  400                 "antigravity-gemini-3.8-flash".to_string()
  401             };
  402             let m_lower = target_model.to_lowercase();
  403             if m_lower.contains("deepseek") {
  404                 ("http://127.0.0.1:8769/v1/chat/completions".to_string(), String::new(), target_model)
  405             } else if m_lower.contains("argon") || m_lower.contains("gemini-web") {
  406                 ("http://127.0.0.1:8768/v1/chat/completions".to_string(), String::new(), target_model)
  407             } else if m_lower.contains("antigravity") || m_lower.contains("3.8-flash") || m_lower.contains("3.7-flash") || m_lower.contains("sonnet") || m_lower.contains("opus") {
  408                 ("http://127.0.0.1:8766/v1/chat/completions".to_string(), String::new(), target_model)
  409             } else {
  410                 let ep = format!("{}/v1/chat/completions", config.hermes_gateway_url.trim_end_matches('/'));
  411                 (ep, config.hermes_auth_token.trim().to_string(), target_model)
  412             }
  413         }
  414     };
  415 
  416     let mut headers = HeaderMap::new();
  417     headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
  418     if !auth_token.is_empty() {
  419         if let Ok(val) = HeaderValue::from_str(&format!("Bearer {}", auth_token)) {
  420             headers.insert(AUTHORIZATION, val);
  421         }
  422     }
  423 
  424     let start_time = std::time::Instant::now();
  425     let body = serde_json::json!({
  426         "model": active_model,
  427         "stream": true,
  428         "messages": [
  429             { "role": "system", "content": augmented_system_prompt },
  430             { "role": "user", "content": message }
  431         ]
  432     });
  433 
  434     let response = cancellation.run(async { client
  435         .post(&url)
  436         .headers(headers)
  437         .json(&body)
  438         .send()
  439         .await
  440         .map_err(|e| format!("Failed to reach AI endpoint ({}): {}", url, e)) }).await?;
  441 
  442     if !response.status().is_success() {
  443         let err_text = cancellation.run(async { Ok(response.text().await.unwrap_or_default()) }).await?;
  444         channel
  445             .send(ChatStreamEvent::Error {
  446                 message: format!("AI Provider error ({}): {}", url, err_text),
  447             })
  448             .ok();
  449         return Ok(());
  450     }
  451 
  452     let is_event_stream = response
  453         .headers()
  454         .get(CONTENT_TYPE)
  455         .and_then(|v| v.to_str().ok())
  456         .map(|ct| ct.contains("text/event-stream"))
  457         .unwrap_or(false);
  458 
  459     if !is_event_stream {
  460         let full_body = cancellation.run(async { response.bytes().await.map_err(|e| e.to_string()) }).await?;
  461         if let Ok(json_val) = serde_json::from_slice::<serde_json::Value>(&full_body) {
  462             if let Some(err_val) = json_val.get("error") {
  463                 let err_msg = if let Some(s) = err_val.as_str() {
  464                     s.to_string()
  465                 } else if let Some(m) = err_val.get("message").and_then(|m| m.as_str()) {

 succeeded in 189ms:
  435     })
  436     .await
  437     .map_err(|e| e.to_string())?
  438 }
