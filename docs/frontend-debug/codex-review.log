 2040         if (!context) throw new Error('Cannot verify this account and storage folder. Try again when online.');
 2041         if (wanted) {
 2042           const plan = await window.AxionCloudSync.prepare(context.snapshot, context.owner);
 2043           const yes = confirm(`Enable automatic backups to ${context.email}?\n\nThis will upload ALL local data in the current storage folder: ${plan.counts.personas} personas, ${plan.counts.frameworks} frameworks, ${plan.counts.anecdotes} anecdotes, ${plan.counts.chats} chats; ${plan.counts.files} files.\n\nLocal data may include work created under another account. Backups run while the app is open, at most once every 5 minutes when files change, with an immediate catch-up. This enables backups for this account and storage folder. Other signed-in accounts also default to automatic backup unless disabled individually. No cloud records will be deleted. Continue?`);
 2044           if (!yes) return;
 2045         }
 2046         await cloudAutoBackup.setEnabled(wanted, context);
 2047         if (wanted) await cloudAutoBackup.poll();
 2048       } catch (error) { cloudBackupStatus(error.message || 'Automatic backup settings could not be saved.', 'error'); }
 2049       finally { renderCloudBackupState(cloudAutoBackup.status()); }
 2050     };
