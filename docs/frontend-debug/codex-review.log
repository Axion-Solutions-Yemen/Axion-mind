  612 #[tauri::command]
  613 async fn import_all_data_json(payload: serde_json::Value) -> Result<String, String> {
  614     tokio::task::spawn_blocking(move || {
  615         let app_dir = crate::personas::get_app_data_dir()?;
  616 
  617         // 1. Restore personas
  618         if let Some(personas_val) = payload.get("personas") {
  619             let personas_file = app_dir.join("personas.json");
  620             let _ = std::fs::write(personas_file, serde_json::to_string_pretty(personas_val).unwrap_or_default());
  621         }
  622 
  623         // 2. Restore chats
  624         if let Some(chats_obj) = payload.get("chats").and_then(|v| v.as_object()) {
  625             let chats_dir = app_dir.join("chats");
  626             let _ = std::fs::create_dir_all(&chats_dir);
  627             for (stem, msgs) in chats_obj {
  628                 let file_path = chats_dir.join(format!("{}.json", stem));
  629                 let _ = std::fs::write(file_path, serde_json::to_string_pretty(msgs).unwrap_or_default());
  630             }
  631         }
  632 
  633         // 3. Restore Dual-RAG Knowledge Cards
  634         if let Some(data_files) = payload.get("personas_data").and_then(|v| v.as_object()) {
  635             let data_dir = app_dir.join("personas_data");
  636             for (rel_path, content_val) in data_files {
  637                 if let Some(content) = content_val.as_str() {
  638                     let target_path = data_dir.join(rel_path.replace('/', std::path::MAIN_SEPARATOR_STR));
  639                     if let Some(parent) = target_path.parent() {
  640                         let _ = std::fs::create_dir_all(parent);
  641                     }
  642                     let _ = std::fs::write(&target_path, content);
  643                 }
  644             }
  645         }
  646 
  647         Ok("Successfully imported and synchronized all data!".to_string())
  648     })
  649     .await
  650     .map_err(|e| e.to_string())?
  651 }
