  307 #[tauri::command]
  308 async fn export_customer_backup() -> Result<String, String> {
  309     tokio::task::spawn_blocking(move || {
  310         use std::fs::File;
  311         use std::io::{Read, Write};
  312         use walkdir::WalkDir;
  313         use zip::write::SimpleFileOptions;
  314 
  315         let hub_dir = personas::get_app_data_dir()?;
  316         let downloads = dirs::download_dir()
  317             .or_else(dirs::desktop_dir)
  318             .ok_or("Cannot locate Downloads directory")?;
  319         
  320         let now = chrono_or_timestamp();
  321         let backup_filename = format!("AxionMind_Backup_{}.zip", now);
  322         let backup_path = downloads.join(&backup_filename);
  323 
  324         let file = File::create(&backup_path).map_err(|e| format!("Failed to create zip: {}", e))?;
  325         let mut zip = zip::ZipWriter::new(file);
  326         let options = SimpleFileOptions::default()
  327             .compression_method(zip::CompressionMethod::Deflated);
  328 
  329         for entry in WalkDir::new(&hub_dir).into_iter().filter_map(|e| e.ok()) {
  330             let path = entry.path();
  331             let rel_path = match path.strip_prefix(&hub_dir) {
  332                 Ok(p) => p,
  333                 Err(_) => continue,
  334             };
  335             let rel_str = rel_path.to_string_lossy().replace('\\', "/");
  336             if rel_str.is_empty() {
  337                 continue;
  338             }
  339 
  340             if entry.file_type().is_dir() {
  341                 let _ = zip.add_directory(&rel_str, SimpleFileOptions::default());
  342             } else if entry.file_type().is_file() {
  343                 zip.start_file(&rel_str, options).map_err(|e| e.to_string())?;
  344                 let mut f = File::open(path).map_err(|e| e.to_string())?;
  345                 let mut buffer = Vec::new();
  346                 f.read_to_end(&mut buffer).map_err(|e| e.to_string())?;
  347                 zip.write_all(&buffer).map_err(|e| e.to_string())?;
  348             }
  349         }
  350 
  351         zip.finish().map_err(|e| format!("Failed to finalize zip: {}", e))?;
  352         Ok(backup_path.to_string_lossy().to_string())
  353     })
  354     .await
  355     .map_err(|e| e.to_string())?
  356 }
