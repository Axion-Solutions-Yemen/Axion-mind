  358 fn chrono_or_timestamp() -> String {
  359     use std::time::{SystemTime, UNIX_EPOCH};
  360     let d = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default();
  361     format!("{}", d.as_secs())
  362 }
