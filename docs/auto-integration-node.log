                  <label style="font-size: 11px; color: var(--ax-text-muted);">Supabase Anon / Public Key</label>
                  <input type="password" class="form-input" id="cfgSupabaseKey" value="sb_publishable_m6nFD1nyCmeP5xMz0K_5Hw_HqIHOr2N" placeholder="Paste your anon public key from Supabase API settings" style="width: 100%; box-sizing: border-box; font-size: 11.5px;">
                </div>
