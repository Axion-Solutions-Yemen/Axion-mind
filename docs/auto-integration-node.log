              <div class="form-group" style="margin-bottom: 10px;">
                <label style="font-size: 12px; color: var(--ax-text-muted);">Email Address</label>
                <input type="email" class="form-input" id="authEmail" value="arafat.trans@gmail.com" placeholder="arafat.trans@gmail.com" style="width: 100%; box-sizing: border-box;">
