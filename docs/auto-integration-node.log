                </div>
                <button type="button" class="btn-action" id="btnLogout" style="border: 1px solid rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.1); color: #fca5a5; padding: 6px 12px; border-radius: 6px; font-size: 11px; cursor: pointer;">Sign Out</button>
              </div>
              <div style="margin-top: 12px; display: flex; gap: 8px;">
                <button type="button" class="btn-action" id="btnForceCloudSync" style="flex: 1; border: 1px solid rgba(99, 102, 241, 0.3); background: rgba(99, 102, 241, 0.15); color: #c7d2fe; padding: 7px 12px; border-radius: 6px; font-size: 11.5px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;">
                  <span>☁</span> Back Up &amp; Verify Now
                </button>
                <button type="button" class="btn-action" id="btnRecoverCloudBackup" style="flex:1;">Recover Cloud Backup</button>
                <button type="button" class="btn-action" id="btnCancelCloudBackup" style="display:none;">Cancel Backup</button>
              </div>
