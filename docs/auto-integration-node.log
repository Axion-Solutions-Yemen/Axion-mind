              <div style="display: flex; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--ax-border); padding-bottom: 10px;">
                <button type="button" id="tabLogin" style="background: none; border: none; font-size: 13px; font-weight: 600; color: var(--ax-primary); cursor: pointer; padding: 4px 8px; border-bottom: 2px solid var(--ax-primary);">Sign In</button>
                <button type="button" id="tabRegister" style="background: none; border: none; font-size: 13px; font-weight: 500; color: var(--ax-text-muted); cursor: pointer; padding: 4px 8px;">Create Free Account</button>
