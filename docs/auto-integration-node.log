          --ax-on-danger: #270b14;
          --ax-danger-subtle: #331520;
          --ax-info: #81b5ff;
          --ax-info-subtle: #112644;
          --ax-accent-violet: #a497ff;
          --ax-accent-aqua: #56e0c0;
          --ax-accent-blue: #729dff;
          --ax-accent-rose: #f594bd;
          --ax-shadow-sm: 0 1px 2px rgb(0 0 0 / 28%);
          --ax-shadow-md: 0 6px 18px rgb(0 0 0 / 24%);
          --ax-shadow-lg: 0 18px 48px rgb(0 0 0 / 32%);
    
          /* Compatibility aliases */
          --bg-darker: var(--ax-bg);
          --bg-dark: #08090e;
          --bg-card: var(--ax-surface);
          --bg-hover: var(--ax-surface-subtle);
          --border-color: var(--ax-border);
          --border-subtle: rgba(255, 255, 255, 0.05);
          --text-main: var(--ax-text);
          --text-muted: var(--ax-muted);
          --accent: var(--ax-primary);
          --accent-hover: var(--ax-primary-hover);
          --bubble-user: #171b27;
          --bubble-assistant: transparent;
          --success: var(--ax-success);
        }
    
        * {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
    
        /* Sleek minimal scrollbars */
        ::-webkit-scrollbar {
          width: 5px;
          height: 5px;
        }
    
        ::-webkit-scrollbar-track {
          background: transparent;
        }
    
        ::-webkit-scrollbar-thumb {
          background: rgba(255, 255, 255, 0.08);
          border-radius: 4px;
        }
    
        ::-webkit-scrollbar-thumb:hover {
          background: rgba(255, 255, 255, 0.16);
        }
    
        body {
          background-color: var(--bg-darker);
          color: var(--text-main);
          height: 100vh;
          overflow: hidden;
          display: flex;
        }
    
        /* Layout */
        #app {
          display: flex;
          width: 100vw;
          height: 100vh;
        }
    
        /* Sidebar */
        .sidebar {
          width: 280px;
          min-width: 250px;
          background: var(--bg-dark);
          border-right: 1px solid var(--border-subtle);
          display: flex;
          flex-direction: column;
          transition: all 0.2s ease;
          z-index: 20;
        }
    
        .sidebar-header {
          padding: 12px 16px;
          border-bottom: 1px solid var(--border-subtle);
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
    
        .app-brand {
          display: flex;
          align-items: center;
          gap: 8px;
        }
    
        .app-brand .logo {
          font-size: 16px;
          background: transparent;
          padding: 0;
          border-radius: 0;
          display: flex;
          align-items: center;
          justify-content: center;
        }
    
        .app-brand h1 {
          font-size: 13.5px;
          font-weight: 600;
          letter-spacing: -0.2px;
          color: #f1f5f9;
        }
    
        .status-badge {
          display: flex;
          align-items: center;
          gap: 5px;
          font-size: 10.5px;
          padding: 2px 8px;
          border-radius: 9999px;
          background: var(--ax-success-subtle);
          color: var(--ax-success);
          border: 1px solid rgb(86 224 192 / 24%);
          font-weight: 500;
        }
    
        .status-badge.offline {
          background: rgba(239, 68, 68, 0.15);
          color: #ef4444;
        }
    
        .status-dot {
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: currentColor;
          box-shadow: 0 0 8px currentColor;
        }
    
        .sidebar-search {
          padding: 8px 12px;
          display: flex;
          gap: 6px;
        }
    
        .search-input {
          flex: 1;
          background: rgba(255, 255, 255, 0.03);
          border: 1px solid var(--border-subtle);
          border-radius: 6px;
          padding: 6px 10px;
          color: var(--text-main);
          font-size: 12px;
          outline: none;
          transition: border 0.15s, background 0.15s;
        }
    
        .search-input:focus {
          border-color: rgba(255, 255, 255, 0.2);
          background: rgba(255, 255, 255, 0.05);
        }
    
        .btn-new-persona {
          background: var(--ax-surface-raised);
          color: var(--ax-text);
          border: 1px solid var(--ax-control-border);
          border-radius: 6px;
          padding: 6px 12px;
          font-size: 13px;
          font-weight: 500;
          cursor: pointer;
          display: flex;
          align-items: center;
          justify-content: center;
          transition: background var(--ax-duration-fast, 120ms), border-color var(--ax-duration-fast, 120ms);
        }
    
        .btn-new-persona:hover {
          background: var(--ax-surface-subtle);
          border-color: var(--ax-primary);
          color: var(--ax-primary);
        }
    
        .btn-new-persona:active {
          transform: scale(0.98);
        }
    
        .personas-list {
          flex: 1;
          overflow-y: auto;
          padding: 8px;
          display: flex;
          flex-direction: column;
          gap: 4px;
        }
    
        .persona-item {
          display: flex;
          align-items: center;
          padding: 6px 10px;
          border-radius: 6px;
          cursor: pointer;
          gap: 8px;
          transition: background 0.12s;
          border: 1px solid transparent;
          user-select: none;
        }
    
        .persona-item:hover {
          background: rgba(255, 255, 255, 0.03);
        }
    
        .persona-item.active {
          background: rgba(255, 255, 255, 0.06);
          border-color: rgba(255, 255, 255, 0.1);
        }
    
        .persona-avatar {
          font-size: 16px;
          width: 28px;
          height: 28px;
          border-radius: 6px;
          background: rgba(255, 255, 255, 0.04);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        }
    
        .persona-info {
          flex: 1;
          overflow: hidden;
        }
    
        .persona-name {
          font-size: 13px;
          font-weight: 500;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          color: var(--text-main);
        }
    
        .persona-title {
          font-size: 11px;
          color: var(--text-muted);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          margin-top: 1px;
        }
    
        /* Unified Sidebar Section Headers */
        .sidebar-section-title {
          padding: 10px 14px 4px 14px;
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--text-muted);
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
    
        .sidebar-section-title span.count-badge {
          background: rgba(255, 255, 255, 0.08);
          padding: 2px 6px;
          border-radius: 8px;
          font-size: 10px;
        }
    
        /* Agent Card Accordion (Clean Minimalist List) */
        .agent-card {
          background: transparent;
          border: 1px solid transparent;
          border-radius: 8px;
          margin-bottom: 2px;
          overflow: hidden;
          transition: background 0.15s, border-color 0.15s;
        }
    
        .agent-card:hover {
          background: rgba(255, 255, 255, 0.02);
        }
    
        .agent-card.active-agent {
          background: rgba(255, 255, 255, 0.03);
        }
    
        .agent-card-header {
          display: flex;
          align-items: center;
          padding: 7px 10px;
          cursor: pointer;
          user-select: none;
          gap: 9px;
          border-radius: 8px;
          transition: background 0.15s;
        }
    
        .agent-card-header:hover {
          background: rgba(255, 255, 255, 0.04);
        }
    
        .agent-avatar {
          font-size: 15px;
          width: 26px;
          height: 26px;
          border-radius: 6px;
          background: rgba(255, 255, 255, 0.04);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        }
    
        .agent-info {
          flex: 1;
          overflow: hidden;
        }
    
        .agent-name-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
    
        .agent-name {
          font-size: 12.5px;
          font-weight: 500;
          color: var(--text-main);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          letter-spacing: -0.1px;
        }
    
        .agent-sessions-count {
          font-size: 9.5px;
          font-weight: 500;
          padding: 0 5px;
          border-radius: 6px;
          background: rgba(255, 255, 255, 0.05);
          color: var(--text-muted);
        }
    
        .agent-title {
          font-size: 10.5px;
          color: var(--text-muted);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          margin-top: 1px;
        }
    
        .agent-toggle {
          font-size: 9px;
          color: #475569;
          transition: transform 0.15s ease;
          margin-left: 2px;
        }
    
        .agent-card.expanded .agent-toggle {
          transform: rotate(180deg);
        }
    
        .agent-sessions-container {
          display: none;
          flex-direction: column;
          gap: 1px;
          padding: 2px 4px 6px 20px;
          margin-left: 12px;
          border-left: 1px solid rgba(255, 255, 255, 0.06);
          max-height: 280px;
          overflow-y: auto;
        }
    
        .agent-card.expanded .agent-sessions-container {
          display: flex;
        }
    
        .sub-session-item {
          display: flex;
          align-items: center;
          gap: 6px;
          padding: 6px 10px;
          border-radius: 6px;
          cursor: pointer;
          font-size: 11.5px;
          color: var(--ax-muted);
          transition: background var(--ax-duration-fast, 120ms), color var(--ax-duration-fast, 120ms);
        }
    
        .sub-session-item:hover {
          background: var(--ax-surface-subtle);
          color: var(--ax-text);
        }
    
        .sub-session-item.active {
          background: linear-gradient(100deg, #27203F, #171423);
          color: #CEC6FF;
          font-weight: 500;
          box-shadow: inset 2px 0 0 var(--ax-accent-violet);
        }
    
        .sub-session-icon {
          font-size: 11px;
          flex-shrink: 0;
          opacity: 0.6;
        }
    
        .sub-session-title {
          flex: 1;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
    
        .sub-session-time {
          font-size: 9.5px;
          color: #475569;
          flex-shrink: 0;
        }
    
        .btn-new-agent-chat {
          display: flex;
          align-items: center;
          gap: 6px;
          padding: 4px 8px;
          margin-bottom: 2px;
          border-radius: 6px;
          font-size: 10.5px;
          color: #94a3b8;
          cursor: pointer;
          transition: color 0.12s, background 0.12s;
        }
    
        .btn-new-agent-chat:hover {
          background: rgba(255, 255, 255, 0.04);
          color: #fff;
        }
    
        /* DeepSeek-style Thinking Accordion (Axion Midnight Style) */
        .thinking-accordion {
          background: var(--ax-surface);
          border: 1px solid rgb(114 157 255 / 24%);
          border-radius: 8px;
          margin-bottom: 12px;
          overflow: hidden;
          box-shadow: 0 4px 14px rgb(0 0 0 / 20%);
          transition: border-color var(--ax-duration-fast, 120ms);
        }
    
        .thinking-accordion:hover {
          border-color: var(--ax-accent-blue);
        }
    
        .thinking-header {
          padding: 7px 12px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          cursor: pointer;
          user-select: none;
          font-size: 11.5px;
          color: var(--ax-accent-blue);
          background: rgb(114 157 255 / 6%);
        }
    
        .thinking-badge {
          display: flex;
          align-items: center;
          gap: 6px;
          font-weight: 500;
        }
    
        .thinking-icon {
          font-size: 13px;
          opacity: 0.9;
        }
    
        .thinking-toggle {
          font-size: 9.5px;
          color: var(--ax-muted);
          transition: transform var(--ax-duration-fast, 120ms) ease;
        }
    
        .thinking-accordion.open .thinking-toggle {
          transform: rotate(180deg);
        }
    
        .thinking-grid {
          display: grid;
          grid-template-rows: 0fr;
          transition: grid-template-rows var(--ax-duration-medium, 180ms) cubic-bezier(0.4, 0, 0.2, 1);
          overflow-anchor: none;
        }
    
        .thinking-accordion.open .thinking-grid {
          grid-template-rows: 1fr;
        }
    
        .thinking-content-inner {
          overflow: hidden;
          border-top: 1px solid var(--ax-border);
          background: var(--ax-bg);
          padding: 0;
        }
    
        .thinking-accordion.open .thinking-content-inner {
          padding: 8px;
        }
    
        /* Elegant, Minimalist Loading State */
        .thinking-live-indicator {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 4px 10px;
          border-radius: 14px;
          background: rgba(99, 102, 241, 0.08);
          border: 1px solid rgba(99, 102, 241, 0.2);
          margin-left: 8px;
          font-size: 11px;
          color: #94a3b8;
          vertical-align: middle;
          animation: thinkingFadeIn 0.2s ease-out;
          user-select: none;
        }
    
        @keyframes thinkingFadeIn {
          from { opacity: 0; transform: translateY(2px); }
          to { opacity: 1; transform: translateY(0); }
        }
    
        .thinking-spinner {
          width: 10px;
          height: 10px;
          border: 1.5px solid rgba(129, 140, 248, 0.25);
          border-top-color: #818cf8;
          border-radius: 50%;
          animation: spinLoader 0.75s linear infinite;
        }
    
        @keyframes spinLoader {
          to { transform: rotate(360deg); }
        }
    
        .thinking-text {
          font-size: 11px;
          font-weight: 500;
          color: #cbd5e1;
          display: inline-flex;
          align-items: center;
          gap: 4px;
        }
    
        .thinking-dots {
          display: inline-flex;
          gap: 2px;
        }
    
        .thinking-dots span {
          width: 3px;
          height: 3px;
          border-radius: 50%;
          background: #818cf8;
          opacity: 0.4;
          animation: dotPulse 1.2s infinite ease-in-out;
        }
    
        .thinking-dots span:nth-child(2) { animation-delay: 0.2s; }
        .thinking-dots span:nth-child(3) { animation-delay: 0.4s; }
    
        @keyframes dotPulse {
          0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
          40% { opacity: 1; transform: scale(1.2); }
        }
    
        .thinking-timer {
          font-size: 10.5px;
          color: #64748b;
          font-variant-numeric: tabular-nums;
        }
    
        /* Tool execution cards inside accordion */
        .tool-calls-container {
          display: flex;
          flex-direction: column;
          gap: 4px;
          max-height: 350px;
          overflow-y: auto;
        }
    
        .tool-card {
          background: var(--ax-surface);
          border: 1px solid var(--ax-border);
          border-radius: 6px;
          overflow: hidden;
          font-size: 11px;
          transition: border-color var(--ax-duration-fast, 120ms);
        }
    
        .tool-card:hover {
          border-color: var(--ax-control-border);
        }
    
        .tool-card-header {
          padding: 5px 10px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          cursor: pointer;
          background: var(--ax-surface-subtle);
          user-select: none;
        }
    
        .tool-card-title {
          display: flex;
          align-items: center;
          gap: 5px;
          font-weight: 500;
          color: var(--ax-text);
          font-size: 11px;
        }
    
        .tool-card-toggle {
          font-size: 9px;
          color: var(--ax-muted);
          transition: transform var(--ax-duration-fast, 120ms);
        }
    
        .tool-card.open .tool-card-toggle {
          transform: rotate(180deg);
        }
    
        .tool-card-body {
          display: none;
          padding: 8px 10px;
          border-top: 1px solid var(--ax-border);
          background: var(--ax-bg);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 10.5px;
          max-height: 240px;
          overflow-y: auto;
          white-space: pre-wrap;
          word-break: break-all;
        }
    
        .tool-card.open .tool-card-body {
          display: block;
        }
    
        .tool-section-label {
          color: #475569;
          font-weight: 600;
          margin-top: 3px;
          margin-bottom: 2px;
          font-size: 9.5px;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
    
        /* Main Chat View */
        .chat-view {
          flex: 1;
          display: flex;
          flex-direction: column;
          background: var(--bg-darker);
          position: relative;
        }
    
        .chat-header {
          padding: 10px 24px;
          background: var(--bg-darker);
          border-bottom: 1px solid var(--border-subtle);
          display: flex;
          align-items: center;
          justify-content: space-between;
        }
    
        .active-persona-details {
          display: flex;
          align-items: center;
          gap: 10px;
        }
    
        .active-persona-avatar {
          font-size: 18px;
          width: 32px;
          height: 32px;
          border-radius: 8px;
          background: rgba(255, 255, 255, 0.04);
          display: flex;
          align-items: center;
          justify-content: center;
        }
    
        .active-persona-title-group h2 {
          font-size: 14px;
          font-weight: 600;
          letter-spacing: -0.2px;
        }
    
        .active-persona-title-group p {
          font-size: 11px;
          color: var(--text-muted);
          margin-top: 1px;
        }
    
        .header-actions {
          display: flex;
          align-items: center;
          gap: 8px;
        }
    
        .btn-action {
          background: var(--ax-surface-raised);
          border: 1px solid var(--ax-border);
          color: var(--ax-muted);
          padding: 5px 12px;
          border-radius: 6px;
          font-size: 11.5px;
          font-weight: 500;
          cursor: pointer;
          display: flex;
          align-items: center;
          gap: 6px;
          transition: background var(--ax-duration-fast, 120ms), border-color var(--ax-duration-fast, 120ms), color var(--ax-duration-fast, 120ms);
        }
    
        .btn-action:hover {
          background: var(--ax-surface-subtle);
          color: var(--ax-text);
          border-color: var(--ax-control-border);
        }
    
        /* Messages container */
        .messages-container {
          flex: 1;
          overflow-y: auto;
          padding: 24px 32px;
          display: flex;
          flex-direction: column;
          gap: 20px;
        }
    
        /* Empty state */
        .empty-state {
          margin: auto;
          max-width: 540px;
          text-align: center;
          padding: 30px;
        }
    
        .empty-state .big-emoji {
          font-size: 56px;
          margin-bottom: 16px;
          display: inline-block;
        }
    
        .empty-state h3 {
          font-size: 20px;
          margin-bottom: 8px;
        }
    
        .empty-state p {
          color: var(--text-muted);
          font-size: 14px;
          line-height: 1.5;
          margin-bottom: 24px;
        }
    
        .starter-prompts {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
          text-align: left;
        }
    
        .starter-card {
          background: var(--ax-surface);
          border: 1px solid var(--ax-border);
          padding: 12px 16px;
          border-radius: 8px;
          cursor: pointer;
          font-size: 12.5px;
          color: var(--ax-muted);
          transition: background var(--ax-duration-fast, 120ms), border-color var(--ax-duration-fast, 120ms), color var(--ax-duration-fast, 120ms);
        }
    
        .starter-card:hover {
          background: var(--ax-surface-subtle);
          color: var(--ax-text);
          border-color: var(--ax-control-border);
        }
    
        /* Message rows (Minimal clean conversation canvas) */
        .message-row {
          display: flex;
          gap: 12px;
          max-width: 820px;
          width: 100%;
          margin: 0 auto;
        }
    
        .message-row.user {
          justify-content: flex-end;
        }
    
        .message-avatar {
          font-size: 15px;
          width: 28px;
          height: 28px;
          border-radius: 6px;
          background: rgba(255, 255, 255, 0.04);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          margin-top: 2px;
        }
    
        .message-row.user .message-avatar {
          display: none;
        }
    
        .message-content {
          background: transparent;
          border: none;
          padding: 2px 0;
          font-size: 13.5px;
          line-height: 1.65;
          color: #e2e8f0;
          max-width: 100%;
          word-break: break-word;
        }
    
        .message-row.user .message-content {
          background: #1e2430;
          border: 1px solid rgba(255, 255, 255, 0.08);
          padding: 9px 14px;
          border-radius: 12px;
          max-width: 75%;
          color: #f8fafc;
        }
    
        /* Markdown inside messages */
        .message-content h1, .message-content h2, .message-content h3 {
          margin-top: 12px;
          margin-bottom: 8px;
        }
        .message-content p {
          margin-bottom: 10px;
        }
        .message-content p:last-child {
          margin-bottom: 0;
        }
        .message-content ul, .message-content ol {
          margin-left: 20px;
          margin-bottom: 10px;
        }
        .message-content code {
          background: rgba(0, 0, 0, 0.3);
          padding: 2px 6px;
          border-radius: 4px;
          font-size: 13px;
        }
        .message-content pre {
          background: #090d16;
          border: 1px solid var(--border-color);
          border-radius: 8px;
          padding: 12px;
          overflow-x: auto;
          margin: 10px 0;
          position: relative;
        }
        .message-content pre code {
          background: none;
          padding: 0;
        }
    
        /* Input Box (Clean Minimal floating capsule) */
        .chat-input-wrapper {
          padding: 12px 24px 18px;
          background: transparent;
          border-top: none;
          max-width: 820px;
          width: 100%;
          margin: 0 auto;
        }
    
        .input-box {
          background: var(--ax-surface);
          border: 1px solid var(--ax-control-border);
          border-radius: 12px;
          display: flex;
          align-items: flex-end;
          padding: 10px 14px;
          gap: 10px;
          box-shadow: var(--ax-shadow-md);
          transition: border-color var(--ax-duration-fast, 120ms), box-shadow var(--ax-duration-fast, 120ms);
        }
    
        .input-box:focus-within {
          border-color: var(--ax-focus);
          box-shadow: 0 0 0 1px var(--ax-focus), var(--ax-shadow-md);
        }
    
        .chat-textarea {
          flex: 1;
          background: transparent;
          border: none;
          outline: none;
          color: var(--ax-text);
          font-size: 13.5px;
          resize: none;
          max-height: 160px;
          min-height: 24px;
          line-height: 1.5;
        }
    
        .btn-send {
          background: var(--ax-primary);
          color: var(--ax-on-primary);
          border: 1px solid rgb(255 255 255 / 16%);
          border-radius: 8px;
          width: 32px;
          height: 32px;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          box-shadow: 0 2px 12px rgb(164 151 255 / 12%), inset 0 1px 0 rgb(255 255 255 / 25%);
          transition: background-color var(--ax-duration-fast, 120ms), box-shadow var(--ax-duration-fast, 120ms);
          flex-shrink: 0;
        }
    
        .btn-send:hover {
          background: var(--ax-primary-hover);
          box-shadow: 0 3px 22px rgb(164 151 255 / 22%);
        }
    
        .btn-stop {
          background: rgba(239, 68, 68, 0.15);
          color: #f87171;
          border: 1px solid rgba(239, 68, 68, 0.3);
          border-radius: 8px;
          width: 32px;
          height: 32px;
          display: none;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          font-size: 13px;
          flex-shrink: 0;
          transition: background 0.15s;
        }
    
        .btn-send:disabled {
          background: #475569;
          cursor: not-allowed;
          opacity: 0.5;
        }
    
        .btn-stop {
          background: #dc2626;
          color: white;
          border: none;
          border-radius: 8px;
          width: 36px;
          height: 36px;
          display: none;
          align-items: center;
          justify-content: center;
          cursor: pointer;
          font-size: 14px;
          flex-shrink: 0;
        }
    
        /* Modal (Axion Dialog Specification) */
        .modal-backdrop {
          position: fixed;
          top: 0;
          left: 0;
          width: 100vw;
          height: 100vh;
          background: rgb(0 0 0 / 76%);
          backdrop-filter: blur(8px);
          display: none;
          align-items: center;
          justify-content: center;
          z-index: 100;
        }
    
        .modal-backdrop.open {
          display: flex;
        }
    
        .modal-card {
          background: var(--ax-surface-raised);
          border: 1px solid var(--ax-border);
          border-radius: 12px;
          width: 520px;
          max-width: 90vw;
          max-height: 90vh;
          overflow-y: auto;
          box-sizing: border-box;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          box-shadow: var(--ax-shadow-lg);
        }
    
        .modal-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
        }
    
        .modal-header h3 {
          font-size: 16px;
          font-weight: 600;
          letter-spacing: -0.2px;
          color: var(--ax-text);
        }
    
        .btn-close-modal {
          background: transparent;
          border: none;
          color: var(--ax-muted);
          font-size: 20px;
          cursor: pointer;
          transition: color var(--ax-duration-fast, 120ms);
        }
    
        .btn-close-modal:hover {
          color: var(--ax-text);
        }
    
        .form-group {
          display: flex;
          flex-direction: column;
          gap: 6px;
        }
    
        .form-group label {
          font-size: 11px;
          font-weight: 500;
          color: var(--ax-muted);
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
    
        .form-input, .form-textarea {
          background: var(--ax-surface);
          border: 1px solid var(--ax-control-border);
          border-radius: 6px;
          padding: 8px 12px;
          color: var(--ax-text);
          font-size: 13px;
          outline: none;
          transition: border-color var(--ax-duration-fast, 120ms), box-shadow var(--ax-duration-fast, 120ms);
        }
    
        .form-input:focus, .form-textarea:focus {
          border-color: var(--ax-focus);
          box-shadow: 0 0 0 1px var(--ax-focus);
        }
    
        .emoji-row {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
          margin-top: 4px;
        }
    
        .emoji-btn {
          background: var(--bg-card);
          border: 1px solid var(--border-color);
          border-radius: 8px;
          font-size: 20px;
          width: 38px;
          height: 38px;
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
        }
    
        .emoji-btn:hover, .emoji-btn.selected {
          border-color: var(--accent);
          background: var(--bg-hover);
        }
    
        .modal-footer {
          display: flex;
          justify-content: flex-end;
          gap: 10px;
          margin-top: 8px;
        }
    
        .btn-secondary {
          background: var(--bg-card);
          border: 1px solid var(--border-color);
          color: var(--text-muted);
          padding: 8px 16px;
          border-radius: 8px;
          cursor: pointer;
          font-size: 13px;
        }
    
        .btn-primary {
          background: var(--accent);
          border: none;
          color: white;
          padding: 8px 18px;
          border-radius: 8px;
          font-size: 13px;
          font-weight: 600;
          cursor: pointer;
        }
    
        /* Mobile toggle */
        .mobile-menu-btn {
          display: none;
          background: transparent;
          border: none;
          color: var(--text-main);
          font-size: 20px;
          cursor: pointer;
          margin-right: 8px;
        }
    
        @media (max-width: 768px) {
          .sidebar {
            position: absolute;
            left: -320px;
            height: 100vh;
          }
          .sidebar.open {
            left: 0;
          }
          .mobile-menu-btn {
            display: block;
          }
          .messages-container {
            padding: 16px;
          }
        }
      </style>
    </head>
    <body>
      <div id="app">
        <!-- Left Sidebar: Personas list -->
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">
            <div class="app-brand" style="display: flex; align-items: center; gap: 10px;">
              <img src="assets/app_logo.png" style="width: 26px; height: 26px; border-radius: 6px; object-fit: contain; box-shadow: 0 2px 8px rgba(0,0,0,0.4);" alt="Axion Mind">
              <div>
                <h1 style="font-size: 15px; font-weight: 700; letter-spacing: -0.2px;">Axion Mind</h1>
              </div>
            </div>
            <div class="status-badge" id="mindStatus">
              <span class="status-dot"></span>
              <span>Online</span>
            </div>
          </div>
    
          <div class="sidebar-search">
            <input type="text" class="search-input" id="searchPersonas" placeholder="Search agents & sessions...">
            <button class="btn-new-persona" id="btnOpenNewPersonaModal" title="Create New Agent">+</button>
          </div>
    
          <div class="personas-list" id="personasList">
            <!-- Injected via JS -->
          </div>
    
          <!-- Persistent Connection Status & Account Settings -->
          <div class="sidebar-footer" style="padding: 10px 14px; border-top: 1px solid var(--ax-border); display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.18);">
            <div id="sidebarAccountPill" style="display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--ax-text-muted); cursor: pointer;" title="Manage Cloud Account & Sync">
              <span id="accountAvatarDot" style="width: 8px; height: 8px; border-radius: 50%; background: #64748b; display: inline-block;" title="Local / Sign In"></span>
              <div style="min-width:0;"><span id="accountUserEmail" style="display:block;font-weight:500;color:var(--ax-text);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Local / Sign In</span><span id="sidebarBackupStatus" role="status" aria-live="polite" style="display:block;font-size:10px;color:var(--ax-text-muted);margin-top:3px;">Local only</span></div>
            </div>
            <div style="display: flex; gap: 6px;">
              <button id="btnOpenDiagnostics" style="background: none; border: 1px solid var(--ax-border); border-radius: 6px; color: var(--ax-text-muted); cursor: pointer; font-size: 12px; padding: 4px 6px; transition: all 0.2s;" title="System Diagnostics & Deep Logs">🩺</button>
              <button id="btnOpenAuthModal" style="background: none; border: 1px solid var(--ax-border); border-radius: 6px; color: var(--ax-text-muted); cursor: pointer; font-size: 12px; padding: 4px 6px; transition: all 0.2s;" title="Cloud Account & Real-Time Sync">☁️</button>
              <button id="btnOpenSettings" style="background: none; border: 1px solid var(--ax-border); border-radius: 6px; color: var(--ax-text-muted); cursor: pointer; font-size: 13px; padding: 4px 6px; transition: all 0.2s;" title="AI Connection Settings">⚙️</button>
            </div>
          </div>
        </aside>
    
        <!-- Main Chat View -->
        <main class="chat-view">
          <header class="chat-header">
            <div class="active-persona-details">
              <button class="mobile-menu-btn" id="btnToggleMobileSidebar">☰</button>
