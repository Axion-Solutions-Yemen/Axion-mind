                <div style="font-size: 11px; font-weight: 600; color: #a5b4fc; text-transform: uppercase; margin-bottom: 6px;">Live Cloud Database Endpoint (Supabase)</div>
                <div class="form-group" style="margin-bottom: 8px;">
                  <label style="font-size: 11px; color: var(--ax-text-muted);">Supabase Project URL</label>
                  <input type="text" class="form-input" id="cfgSupabaseUrl" value="https://kefxeysyvtdxxdupkapa.supabase.co" placeholder="https://kefxeysyvtdxxdupkapa.supabase.co" style="width: 100%; box-sizing: border-box; font-size: 11.5px;">
                </div>
