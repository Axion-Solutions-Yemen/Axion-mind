                <h2 id="activePersonaName">Select an Agent</h2>
                <p id="activePersonaTitle">Click an agent or session on the left to start</p>
              </div>
            </div>
    
            <div class="header-actions">
              <button class="btn-action" id="btnHermesControl" style="color: var(--ax-primary); border-color: rgb(164 151 255 / 30%);" title="Open Hermes Mind Control Center">⚡ Hermes Control</button>
              <button class="btn-action" id="btnToggleAllThinking" title="Toggle all thinking blocks in this conversation">🧠 Toggle Thinking</button>
              <button class="btn-action" id="btnEditPersona">⚙️ Edit Persona</button>
              <button class="btn-action" id="btnClearChat">🗑️ Clear Chat</button>
            </div>
          </header>
    
          <div class="messages-container" id="messagesContainer">
            <!-- Messages or empty state injected via JS -->
          </div>
    
          <div class="chat-input-wrapper">
            <!-- ChatGPT-style Model Picker Bar -->
            <div class="chat-input-toolbar" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; padding: 0 4px;">
              <div style="display: flex; align-items: center; gap: 8px; position: relative;">
                <button type="button" id="btnChatModelPicker" style="display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.06); border: 1px solid var(--ax-border); border-radius: 18px; padding: 4px 12px; font-size: 12px; font-weight: 500; color: var(--ax-text); cursor: pointer; transition: all 0.2s;">
                  <span id="chatModelPickerIcon" style="font-size: 13px;">🧠</span>
                  <span id="chatModelPickerLabel" style="max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">antigravity-gemini-3.8-flash</span>
                  <span style="font-size: 9px; opacity: 0.6; margin-left: 2px;">▼</span>
                </button>
    
                <!-- Floating ChatGPT-style Model Dropdown Menu -->
                <div id="chatModelDropdownMenu" style="display: none; position: absolute; bottom: calc(100% + 8px); left: 0; width: 320px; max-height: 380px; overflow-y: auto; background: #0c121e; border: 1px solid var(--ax-border); border-radius: 12px; box-shadow: 0 12px 36px rgba(0,0,0,0.7); z-index: 1000; padding: 6px;">
                  <!-- Populated dynamically via JS -->
                </div>
              </div>
    
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" class="quick-model-btn" onclick="quickSelectChatModel('antigravity-gemini-3.8-flash')" style="background: none; border: 1px solid var(--ax-border); border-radius: 12px; font-size: 11px; color: var(--ax-text-muted); padding: 2px 8px; cursor: pointer; transition: all 0.2s;">Gemini 3.8</button>
                <button type="button" class="quick-model-btn" onclick="quickSelectChatModel('gemini-4-argon')" style="background: none; border: 1px solid var(--ax-border); border-radius: 12px; font-size: 11px; color: var(--ax-text-muted); padding: 2px 8px; cursor: pointer; transition: all 0.2s;">Argon</button>
                <button type="button" class="quick-model-btn" onclick="quickSelectChatModel('deepseek-v4')" style="background: none; border: 1px solid var(--ax-border); border-radius: 12px; font-size: 11px; color: var(--ax-text-muted); padding: 2px 8px; cursor: pointer; transition: all 0.2s;">DeepSeek V4</button>
              </div>
            </div>
    
            <div class="input-box">
              <textarea class="chat-textarea" id="chatInput" rows="1" placeholder="Type a message... (Enter to send, Shift+Enter for newline)"></textarea>
              <button class="btn-send" id="btnSend">➤</button>
              <button class="btn-stop" id="btnStop">⬛</button>
            </div>
          </div>
        </main>
      </div>
    
      <!-- Hermes Control Center Modal -->
      <div class="modal-backdrop" id="hermesControlModal">
        <div class="modal-card" style="width: 640px;">
          <div class="modal-header">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 20px;">⚡</span>
              <h3 style="font-size: 16px; font-weight: 600;">Hermes Control Center</h3>
            </div>
            <button class="btn-close-modal" id="btnCloseHermesModal">&times;</button>
          </div>
    
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <!-- Dynamic Connected Model Dropdown -->
            <div class="form-group">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--ax-text-muted); letter-spacing: 0.5px;">Active Global Model (/model)</label>
                <span id="hermesModelStatusBadge" style="font-size: 11px; color: #10b981; font-weight: 500;">Connected AIs Loaded</span>
              </div>
              <div style="display: flex; gap: 8px; align-items: center;">
                <select class="form-input" id="hermesModelSelect" style="flex: 1; padding: 9px 12px; font-size: 13px; font-weight: 500; background: var(--ax-surface); color: var(--ax-text); border: 1px solid var(--ax-border); border-radius: 8px; cursor: pointer;">
                  <option value="" disabled selected>⏳ Detecting connected AI models...</option>
                </select>
                <button type="button" class="btn-action" id="btnRefreshModels" title="Refresh Connected Models" style="padding: 9px 12px; font-size: 13px; border: 1px solid var(--ax-border); border-radius: 8px; cursor: pointer;">🔄</button>
                <button type="button" class="btn-action" id="btnApplyModel" style="background: var(--ax-primary); color: var(--ax-on-primary); font-weight: 600; padding: 9px 16px; border-radius: 8px; border: none; cursor: pointer; white-space: nowrap;">Apply Model</button>
              </div>
              <!-- Manual Custom Model Input (shown if user selects Custom) -->
              <div id="hermesManualModelContainer" style="display: none; margin-top: 8px;">
                <input type="text" class="form-input" id="hermesModelInput" placeholder="Enter custom model identifier (e.g. gpt-4o, claude-3-5-sonnet)">
              </div>
            </div>
    
            <!-- Quick Slash Command Trigger -->
            <div class="form-group">
              <label>Quick Actions</label>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <button class="btn-action" onclick="runHermesQuickCommand('doctor')">🩺 Doctor Check</button>
                <button class="btn-action" onclick="runHermesQuickCommand('version')">ℹ️ Version Info</button>
                <button class="btn-action" onclick="runHermesQuickCommand('config get model')">🔍 Current Model</button>
                <button class="btn-action" onclick="runHermesQuickCommand('config get display')">🎨 Display Settings</button>
                <button class="btn-action" onclick="runHermesQuickCommand('gateway status')">🌐 Gateway Status</button>
