            </p>
    
            <!-- Auth State: Logged In View -->
            <div id="authLoggedInView" style="display: none; padding: 14px; border-radius: 8px; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.22); margin-bottom: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-size: 11px; color: #a5b4fc; font-weight: 600; text-transform: uppercase;">Logged In Account</div>
                  <div id="loggedInUserEmail" style="font-size: 14px; font-weight: 600; color: #fff; margin-top: 2px;">user@example.com</div>
